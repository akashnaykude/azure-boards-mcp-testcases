# Azure DevOps organization name (for https://dev.azure.com/<org>)
AZDO_ORG=your-azure-devops-organization

# Azure DevOps project name (for https://dev.azure.com/<org>/<project>)
AZDO_PROJECT=your-azure-devops-project

# Azure DevOps Personal Access Token with Work Items (Read) scope
AZDO_PAT=your-personal-access-token

# Optional API version override
AZDO_API_VERSION=7.1-preview.3
